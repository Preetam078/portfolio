---
import ProjectGallery from '../solid/ProjectGallery'
import SectionTitle from '../ui/SectionTitle.astro'
import type { Project } from '../../types/portfolio'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
---

<section id="work" class="relative overflow-hidden py-20">
  <div class="pattern-grid fade-edges absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionTitle icon="folder" title="Selected Work" />
    <p class="reveal mb-10 max-w-3xl text-copy-16 text-zinc-400 text-shadow-subtle">
      Recruiter-friendly summaries now, with clear placeholders for demos, code links, architecture notes, and case studies later.
    </p>

    <ProjectGallery projects={projects} />
  </div>
</section>

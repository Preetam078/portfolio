---
import SectionTitle from '../ui/SectionTitle.astro'
import SvgIcon from '../ui/SvgIcon.astro'
import type { IconName } from '../ui/iconPaths'
import type { SkillCategory } from '../../types/portfolio'

interface Props {
  skills: SkillCategory[]
}

const { skills } = Astro.props
const skillIcons: IconName[] = ['codepen', 'layers', 'gauge', 'test-tube', 'server', 'target']
---

<section id="skills" class="relative overflow-hidden py-20">
  <div class="pattern-lines fade-edges absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <SectionTitle align="right" icon="codepen" title="Skills" />

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {skills.map((category, index) => (
        <article class="glass-card reveal rounded-xl p-6" style={`transition-delay: ${index * 70}ms`}>
          <div class="mb-5 flex items-center gap-3">
            <span class="icon-badge">
              <SvgIcon class="size-5" name={skillIcons[index] ?? 'sparkles'} />
            </span>
            <h3 class="text-heading-20 text-white">{category.title}</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {category.skills.map(skill => (
              <span class="skill-badge rounded-full border border-zinc-700 bg-black/80 px-3 py-1.5 text-label-13 text-zinc-300">
                {skill}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---
import SectionTitle from '../ui/SectionTitle.astro'
import SvgIcon from '../ui/SvgIcon.astro'
import type { IconName } from '../ui/iconPaths'
import type { ProofLink } from '../../types/portfolio'

interface Props {
  proofLinks: ProofLink[]
}

const { proofLinks } = Astro.props
const proofLinkIcons: IconName[] = ['github', 'external', 'component', 'workflow', 'gauge', 'chart-up', 'file-text', 'book-open']
---

<section id="proof-links" class="relative overflow-hidden py-20">
  <div class="pattern-hexagons fade-edges absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <SectionTitle icon="file-text" title="Code / Proof Links" />
    <p class="reveal mb-10 max-w-3xl text-copy-16 text-zinc-400 text-shadow-subtle">A compact checklist for the strongest artifacts to add before outreach.</p>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {proofLinks.map((item, index) => (
        <article class="glass-card reveal rounded-xl p-6" style={`transition-delay: ${index * 60}ms`}>
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-start gap-3">
              <span class="icon-badge">
                <SvgIcon class="size-5" name={proofLinkIcons[index] ?? 'external'} />
              </span>
              <div>
                <h3 class="text-heading-20 text-gradient-mono">{item.label}</h3>
                {item.description && <p class="mt-2 text-copy-13 text-zinc-400">{item.description}</p>}
              </div>
            </div>
            {item.href ? (
              <a
                aria-label={`Open ${item.label}`}
                class="rounded-full border border-zinc-800 px-2.5 py-1 text-label-12 text-zinc-300 transition-colors hover:border-white hover:text-white"
                href={item.href}
                rel="noreferrer"
                target="_blank"
              >
                Open
              </a>
            ) : (
              <span class="rounded-full border border-zinc-800 px-2.5 py-1 text-label-12 text-zinc-500">{item.status}</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="mt-10 space-y-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex justify-center">
        <a href="https://leetcode.com/preetammondal78" target="_blank" rel="noopener noreferrer" class="glass-card w-130 group bg-black relative block rounded-xl border border-white/10 p-2 transition-all duration-300 hover:scale-[1.01] hover:border-white/20 shadow-xl">
          <img 
            src="https://leetcard.jacoblin.cool/preetammondal78?theme=dark&font=Outfit&ext=heatmap" 
            alt="Leetcode Heatmap" 
            class="block w-full h-auto opacity-80 transition-opacity group-hover:opacity-100"
          />
        </a>
      </div>

      <div class="flex justify-center mt-10">
        <a href="https://github.com/preetam078" target="_blank" rel="noopener noreferrer" class="glass-card w-250 group bg-black relative block rounded-xl border border-white/10 p-2 transition-all duration-300 hover:scale-[1.01] hover:border-white/20 shadow-xl">
          <img 
            src="https://github-readme-activity-graph.vercel.app/graph?username=preetam078&theme=github-compact&hide_border=true&area=true&bg_color=00000000" 
            alt="GitHub Contribution Heatmap" 
            class="block w-full h-auto opacity-70 transition-opacity group-hover:opacity-100"
          />
        </a>
      </div>
    </div>
  </div>
</section>

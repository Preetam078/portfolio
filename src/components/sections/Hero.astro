---
import HeroGrid from '../ui/HeroGrid.astro'
import SvgIcon from '../ui/SvgIcon.astro'
import type { IconName } from '../ui/iconPaths'
import type { HeroContent } from '../../types/portfolio'

interface Props {
  hero: HeroContent
}

const { hero } = Astro.props
const trustIcons: IconName[] = ['briefcase', 'codepen', 'globe', 'gauge']
const heroHeadlineParts = hero.headline.startsWith('Frontend ')
  ? {
      lead: 'Frontend',
      rest: hero.headline.replace(/^Frontend\s+/, ''),
    }
  : null
---

<section id="home" class="hero-section relative flex items-center justify-center overflow-hidden pt-20">
  <HeroGrid />

  <div class="pointer-events-none relative z-10 mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
    <div class="space-y-5">
      <p class="animate-fade-in-up text-label-14-mono text-zinc-400 text-shadow-subtle [animation-delay:100ms]">
        {hero.eyebrow}
      </p>
      <p class="animate-fade-in-up font-mono text-label-16 text-zinc-300 text-shadow-subtle [animation-delay:150ms]">
        {hero.role}
      </p>
      <h1 class="animate-fade-in-up mx-auto max-w-5xl text-heading-64 text-white text-shadow-subtle [animation-delay:200ms] lg:text-heading-72">
        {heroHeadlineParts ? (
          <>
            <span class="text-gradient-aurora font-black">{heroHeadlineParts.lead}</span>{' '}
            {heroHeadlineParts.rest}
          </>
        ) : (
          hero.headline
        )}
      </h1>
      <p class="animate-fade-in-up mx-auto max-w-3xl text-copy-20 text-zinc-400 text-shadow-subtle [animation-delay:300ms]">
        {hero.summary}
      </p>
    </div>

    <ul class="animate-fade-in-up mx-auto mt-7 flex max-w-4xl flex-wrap justify-center gap-2 [animation-delay:400ms]" aria-label="Trust signals">
      {hero.trustSignals.map((signal, index) => (
        <li class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-black/55 px-3 py-1.5 text-label-13 text-zinc-300 backdrop-blur">
          <SvgIcon class="size-3.5 text-zinc-100" name={trustIcons[index] ?? 'sparkles'} />
          {signal}
        </li>
      ))}
    </ul>

    <div class="animate-fade-in-up flex flex-col items-center justify-center gap-3 pt-8 [animation-delay:500ms] sm:flex-row sm:flex-wrap">
      {hero.ctas.map(cta => (
        <a
          class:list={[
            'pointer-events-auto flex items-center gap-2 rounded-full px-6 py-3 text-button-14 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black',
            cta.variant === 'primary'
              ? 'bg-white text-black shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:bg-zinc-200'
              : 'border border-zinc-700 text-zinc-300 hover:border-white hover:text-white',
          ]}
          href={cta.href}
          aria-label={cta.isPlaceholder ? `${cta.label} placeholder` : undefined}
        >
          {cta.label}
          {cta.icon && <SvgIcon class="size-4" name={cta.icon} />}
        </a>
      ))}
    </div>
  </div>
</section>

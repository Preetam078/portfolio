---
import SectionTitle from '../ui/SectionTitle.astro'
import SvgIcon from '../ui/SvgIcon.astro'
import type { IconName } from '../ui/iconPaths'
import type { ProofSnapshotContent } from '../../types/portfolio'

interface Props {
  proof: ProofSnapshotContent
}

const { proof } = Astro.props
const proofIcons: IconName[] = ['briefcase', 'globe', 'chart-up', 'gauge', 'users', 'rocket']
---

<section id="proof" class="relative overflow-hidden py-20">
  <div class="pattern-lines fade-edges absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionTitle icon="badge-check" title={proof.heading} />

    <p class="reveal mb-10 max-w-3xl text-copy-16 text-zinc-400 text-shadow-subtle">{proof.summary}</p>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {proof.points.map((point, index) => (
        <article class="glass-card reveal rounded-xl p-6" style={`transition-delay: ${index * 70}ms`}>
          <div class="mb-3 flex items-start justify-between gap-4">
            <p class="text-heading-40 text-gradient-warm">{point.value}</p>
            <span class="icon-badge icon-badge--warm">
              <SvgIcon class="size-5" name={proofIcons[index] ?? 'sparkles'} />
            </span>
          </div>
          <h3 class="mb-2 text-label-16 text-white">{point.label}</h3>
          {point.detail && <p class="text-copy-14 text-zinc-400">{point.detail}</p>}
        </article>
      ))}
    </div>
  </div>
</section>

---
import SectionTitle from '../ui/SectionTitle.astro'
import SvgIcon from '../ui/SvgIcon.astro'
import type { EducationContent } from '../../types/portfolio'

interface Props {
  education: EducationContent
}

const { education } = Astro.props
---

<section id="education" class="relative overflow-hidden py-20">
  <div class="pattern-grid fade-edges absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <SectionTitle align="right" icon="book-open" title="Education" />

    <article class="glass-card reveal rounded-xl p-6 md:p-8">
      <div class="mb-5 flex items-start gap-4">
        <span class="icon-badge icon-badge--warm">
          <SvgIcon class="size-5" name="book-open" />
        </span>
        <div>
          <p class="mb-3 text-label-13-mono text-zinc-500">{education.dates} · {education.location}</p>
          <h3 class="text-heading-24 text-white">{education.degree}</h3>
        </div>
      </div>
      <p class="text-copy-16 text-zinc-300">{education.institution}</p>
      <p class="mt-4 text-label-14 text-zinc-400">GPA: {education.gpa}</p>
    </article>
  </div>
</section>

---
import SectionTitle from '../ui/SectionTitle.astro'
import SvgIcon from '../ui/SvgIcon.astro'
import type { AboutContent } from '../../types/portfolio'

interface Props {
  about: AboutContent
}

const { about } = Astro.props
---

<section id="about" class="relative overflow-hidden py-20">
  <div class="pattern-dots fade-edges absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <SectionTitle icon="user" title={about.heading} />

    <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">
      <div class="reveal space-y-8 text-shadow-subtle">
        <p class="text-copy-20 text-zinc-300">{about.body}</p>

        <div class="border-t border-zinc-800 pt-6">
          <p class="mb-4 text-label-14-mono text-zinc-500">Especially strong at</p>
          <ul class="grid gap-3 text-copy-14 text-zinc-400 sm:grid-cols-2">
            {about.strengths.slice(0, 6).map(item => (
              <li class="flex gap-3">
                <span class="mt-0.5 flex size-7 flex-none items-center justify-center rounded-full border border-orange-300/25 bg-orange-500/10 text-orange-200">
                  <SvgIcon class="size-3.5" name="check" />
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="reveal relative mx-auto flex max-w-md justify-center md:ml-auto">
        <div class="group relative">
          <div class="absolute inset-0 -z-10 translate-x-4 translate-y-4 rounded-xl border-2 border-zinc-600 transition-transform duration-300 group-hover:translate-x-2 group-hover:translate-y-2"></div>
          <div class="portrait-card relative z-10 flex h-80 w-72 items-center justify-center overflow-hidden rounded-xl border border-white/20 bg-zinc-900 grayscale transition-all duration-500 group-hover:grayscale-0">
            <div class="portrait-card__grid"></div>
            <div class="portrait-card__mark" aria-label={about.portrait.alt} role="img">{about.portrait.initials}</div>
            <div class="absolute inset-0 bg-black/35 mix-blend-multiply transition-opacity duration-300 group-hover:opacity-0"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

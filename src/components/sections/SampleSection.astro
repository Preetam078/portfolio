<section id="sample" class="relative overflow-hidden py-32">
  <div class="pattern-dots fade-edges absolute inset-0 z-0"></div>
  
  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="reveal mb-6 text-heading-48 text-white text-shadow-subtle md:text-heading-56">Sample Page</h2>
    <p class="reveal mx-auto mb-12 max-w-2xl text-copy-20 text-zinc-400 text-shadow-subtle">
      This is a brand new page created using Astro's file-based routing. No external router libraries needed!
    </p>
    
    <a 
      id="back-button"
      href="/" 
      class="inline-flex items-center justify-center rounded-full bg-white px-8 py-4 text-button-14 font-medium text-black shadow-[0_0_20px_rgba(255,255,255,0.2)] transition-all hover:bg-zinc-200"
    >
      Return to Home Page
    </a>
  </div>
</section>

<script>
  // Wrap in astro:page-load to ensure it works after internal navigations
  document.addEventListener('astro:page-load', () => {
    const backButton = document.getElementById('back-button');
    if (backButton) {
      backButton.addEventListener('click', (e) => {
        // If the user has a history entry to go back to, use it to preserve scroll position
        if (window.history.length > 1) {
          e.preventDefault();
          window.history.back();
        }
      });
    }
  });
</script>
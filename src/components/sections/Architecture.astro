---
import { Image } from 'astro:assets'; // Import Astro's Image component
import imageMap from '@/assets';
import SectionTitle from '../ui/SectionTitle.astro';

interface ArchitectureItem {
  title: string;
  description: string;
  imageUrl?: string;
  navigationPath?: string;
  frontendTemplate?: string;
  template?: string;
}

interface Props {
  architecture: {
    headline: string;
    root: ArchitectureItem[]
    frontend: ArchitectureItem[];
    backend: ArchitectureItem[];
  };
}

const { architecture } = Astro.props;
const items = [
  ...(architecture?.root || [])
].filter(item => item && item.title);
---

<!-- Resource Hints for faster diagram loading -->
<link rel="preconnect" href="https://viewer.diagrams.net" />
<link rel="preconnect" href="https://drive.google.com" />
<link rel="dns-prefetch" href="https://viewer.diagrams.net" />

<section id="architecture" class="relative overflow-hidden py-20">
  <div class="pattern-grid fade-edges absolute inset-0 z-0"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionTitle icon="layers" title="Engineering Architecture" />
    <p class="reveal mb-10 max-w-3xl text-copy-16 text-zinc-400 text-shadow-subtle">
      {architecture?.headline}
    </p>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item, index) => (
        <article
          class={`architecture-item group glass-card reveal overflow-hidden rounded-xl transition-all duration-300 ${item.template ? 'cursor-pointer hover:scale-[1.01] hover:border-white/20' : ''}`}
          style={`transition-delay: ${index * 70}ms`}
          data-template={item.template}
          data-navigation-path={item.navigationPath}
        >
          {(() => {
            const imageKey = (item.imageUrl) as keyof typeof imageMap;
            const resolvedImage = imageKey ? imageMap[imageKey] : undefined;
            
            if (!resolvedImage) return null;
            
            return (
              <div class="relative aspect-video w-full overflow-hidden border-b border-white/5 bg-zinc-900/50">
                <Image
                  src={resolvedImage}
                  alt={item.title}
                  class="absolute inset-0 h-full w-full object-cover opacity-50 transition-opacity group-hover:opacity-100"
                  loading="lazy"
                  widths={[480, 768, 1024]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
                  format="webp"
                  quality={80}
                />
              </div>
            );
          })()}
          <div class="p-6">
            <h3 class="text-heading-20 text-white mb-3">{item.title}</h3>
            <p class="text-copy-14 text-zinc-400 leading-relaxed">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Architecture Detail Modal -->
  <div id="arch-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="glass-card max-w-6xl w-full p-4 pt-16 rounded-xl relative border border-white/10 shadow-2xl max-h-[95vh] overflow-hidden flex flex-col bg-zinc-950">
      <button id="modal-close" type="button" class="absolute top-4 right-6 z-50 text-zinc-400 hover:text-white transition-colors bg-black/50 p-1 rounded-full border border-white/10" aria-label="Close modal">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <!-- Shimmer overlay for the content area -->
      <div id="modal-shimmer" class="absolute inset-x-4 top-16 bottom-4 flex items-center justify-center bg-zinc-800 rounded-lg shimmer-bg z-40 transition-opacity duration-300 opacity-0 pointer-events-none">
        <svg class="animate-spin h-8 w-8 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <div id="modal-content" class="w-full h-[70vh] overflow-auto rounded-lg relative"></div>
    </div>
  </div>

  <style is:global>
    @keyframes pulse-bg {
      0%, 100% { background-color: rgba(255, 255, 255, 0.05); }
      50% { background-color: rgba(255, 255, 255, 0.1); }
    }

    .shimmer-bg {
      animation: pulse-bg 1.5s infinite ease-in-out;
    }
  </style>

<script>
  import { navigate } from 'astro:transitions/client';

  document.addEventListener('astro:page-load', () => {
    const items = document.querySelectorAll('.architecture-item');
    const modal = document.getElementById('arch-modal');
    const closeBtn = document.getElementById('modal-close');
    const contentContainer = document.getElementById('modal-content');
    const shimmer = document.getElementById('modal-shimmer');

    let diagramLoadTimeout: ReturnType<typeof setTimeout> | undefined;
    let observer: MutationObserver | undefined;

    function hideShimmer() {
      if (shimmer) {
        shimmer.classList.add('opacity-0', 'pointer-events-none');
      }
      if (diagramLoadTimeout) {
        clearTimeout(diagramLoadTimeout);
      }
      if (observer) {
        observer.disconnect();
      }
    }

    function showShimmer() {
      if (shimmer) {
        shimmer.classList.remove('opacity-0', 'pointer-events-none');
      }
    }

    function toggleModal(show: boolean) {
      if (!modal) return;

      if (show) {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        document.body.style.overflow = 'hidden';
        showShimmer(); // Show shimmer when modal opens
      } else {
        modal.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
        if (contentContainer) contentContainer.innerHTML = '';
        hideShimmer(); // Hide shimmer when modal closes
      }
    }

    items.forEach(item => {
      item.addEventListener('click', () => {
        const navPath = item.getAttribute('data-navigation-path');
        const target = navPath ? `/sample/${navPath}` : '/sample';
        navigate(target);

        /* Existing modal and diagram loading logic commented out
        const template = item.getAttribute('data-template');

        if (contentContainer && template) {
          contentContainer.innerHTML = '';
          
          // Optimize script loading with high fetch priority and async execution (safety check for template)
          const optimizedTemplate = (template || '').replace('<script', '<script async fetchpriority="high" ');
          
          const fragment = document.createRange().createContextualFragment(optimizedTemplate);
          contentContainer.appendChild(fragment);

          // Wait for the draw.io script to populate the contentContainer
          // Use MutationObserver to detect when children (like SVG/canvas) are added inside .mxgraph
          observer = new MutationObserver((mutationsList, observerInstance) => {
            const mxgraphDiv = contentContainer.querySelector('.mxgraph');
            if (mxgraphDiv && (mxgraphDiv.querySelector('svg') || mxgraphDiv.querySelector('canvas'))) {
              hideShimmer();
              observerInstance.disconnect(); // Stop observing once content is loaded
            }
          });

          // Observe the contentContainer for changes to its children and their descendants
          observer.observe(contentContainer, { childList: true, subtree: true });

          // Fallback timeout in case observer doesn't catch it or for very fast loads

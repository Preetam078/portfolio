---
import SvgIcon from '../ui/SvgIcon.astro'
import type { SocialLink } from '../../types/portfolio'

interface Props {
  author: string
  socials: SocialLink[]
}

const { author, socials } = Astro.props
const year = new Date().getFullYear()
---

<footer class="bg-black py-8 text-center">
  <div class="mb-6 flex justify-center gap-6">
    {socials.map(social => (
      <a
        aria-label={social.label}
        class="inline-block text-zinc-500 transition-all duration-300 hover:-translate-y-1 hover:text-white"
        href={social.href}
        rel={social.isPlaceholder ? undefined : 'noreferrer'}
        target={social.isPlaceholder ? undefined : '_blank'}
      >
        <SvgIcon class="size-5" name={social.icon} />
      </a>
    ))}
  </div>
  <p class="font-mono text-sm text-zinc-500">Built by {author}</p>
  <p class="mt-2 font-mono text-xs text-zinc-600">&copy; {year} All rights reserved.</p>
</footer>

---
import SectionTitle from '../ui/SectionTitle.astro'
import SvgIcon from '../ui/SvgIcon.astro'
import type { IconName } from '../ui/iconPaths'
import type { CapabilityBlock } from '../../types/portfolio'

interface Props {
  strengths: CapabilityBlock[]
}

const { strengths } = Astro.props
const strengthIcons: IconName[] = ['monitor', 'gauge', 'component', 'layers', 'test-tube', 'target']
---

<section id="strengths" class="relative overflow-hidden py-20">
  <div class="pattern-hexagons fade-edges absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <SectionTitle align="right" icon="sparkles" title="Frontend Engineering Strengths" />

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {strengths.map((item, index) => (
        <article class="glass-card reveal rounded-xl p-6" style={`transition-delay: ${index * 70}ms`}>
          <div class="mb-5 flex items-center justify-between gap-4">
            <span class="icon-badge icon-badge--warm">
              <SvgIcon class="size-5" name={strengthIcons[index] ?? 'sparkles'} />
            </span>
          </div>
          <h3 class="text-heading-20 text-gradient-mono">{item.title}</h3>
        </article>
      ))}
    </div>
  </div>
</section>

---
import SectionTitle from '../ui/SectionTitle.astro'
import SvgIcon from '../ui/SvgIcon.astro'
import type { Experience } from '../../types/portfolio'

interface Props {
  experience: Experience[]
}

const { experience } = Astro.props
---

<section id="experience" class="relative overflow-hidden py-20">
  <div class="pattern-dots fade-edges-soft absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <SectionTitle icon="briefcase" title="Experience" />

    <div class="experience-timeline relative">
      <div class="absolute bottom-10 left-3 top-3 hidden w-px bg-gradient-to-b from-transparent via-white/25 to-transparent md:block"></div>
      <div class="experience-timeline-fill absolute bottom-10 left-3 top-3 hidden w-px origin-top bg-gradient-to-b from-white via-white to-white/20 shadow-[0_0_16px_rgba(255,255,255,0.55)] transition-transform duration-75 md:block"></div>

      {experience.map((role, index) => (
        <div class="reveal group relative grid gap-5 pb-8 last:pb-0 md:grid-cols-[48px_1fr]" style={`transition-delay: ${index * 90}ms`}>
          <div class="relative hidden md:block">
            <div class="absolute left-3 top-8 z-10 flex size-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-white/25 bg-zinc-950/95 text-label-12-mono text-white shadow-[0_0_22px_rgba(255,255,255,0.18)]">
              0{index + 1}
            </div>
          </div>

          <article class="glass-card rounded-xl p-6 md:p-8">
            <div class="mb-6 grid gap-5 border-b border-zinc-800 pb-6 lg:grid-cols-[1fr_auto]">
              <div>
                <div class="mb-3 flex items-center gap-3 md:hidden">
                  <span class="flex size-7 items-center justify-center rounded-full border border-white/20 bg-white/10 text-label-12-mono text-white">
                    0{index + 1}
                  </span>
                  <span class="h-px flex-1 bg-gradient-to-r from-white/25 to-transparent"></span>
                </div>
                <p class="mb-2 inline-flex items-center gap-2 text-label-13-mono text-zinc-500">
                  <SvgIcon class="size-4 text-zinc-300" name="server" />
                  {role.domain}
                </p>
                <div class="flex items-center gap-2">
                  {role.companyLogo && (
                    <img src={role.companyLogo} alt={`${role.company} logo`} class="size-10 rounded-sm border border-white/10 bg-zinc-900/50 object-contain grayscale transition-all duration-300 group-hover:grayscale-0" />
                  )}
                  <h3 class="text-heading-24 text-gradient-mono">{role.company}</h3>
                </div>
                <p class="mt-2 text-label-16 text-zinc-300">{role.role}</p>
              </div>
              <p class="h-fit rounded-full border border-zinc-800 bg-black/60 px-3 py-1.5 text-label-13 text-zinc-500">{role.dates}</p>
            </div>

            <div class="grid gap-8 lg:grid-cols-[1fr_280px]">
              <ul class="space-y-3 text-copy-14 text-zinc-400">
                {role.achievements.slice(0, 2).map(item => (
                  <li class="flex gap-3">
                    <SvgIcon class="mt-1 size-4 flex-none text-green-400" name="check" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <div class="space-y-5">
                <div>
                  <p class="mb-3 text-label-12-mono text-zinc-500">Stack</p>
                  <div class="flex flex-wrap gap-2">
                    {role.stack.slice(0, 5).map(item => (
                      <span class="rounded-full border border-zinc-800 bg-black/70 px-2.5 py-1 text-label-12 text-zinc-400">{item}</span>
                    ))}
                  </div>
                </div>

                <div>
                  <p class="mb-3 text-label-12-mono text-zinc-500">Related work</p>
                  <ul class="space-y-2 text-copy-13 text-zinc-400">
                    {role.relatedWork.map(item => <li>{item}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

---
import SvgIcon from './SvgIcon.astro'
import type { IconName } from './iconPaths'

interface Props {
  align?: 'left' | 'right' | 'center'
  eyebrow?: string
  icon?: IconName
  title: string
}

const { align = 'left', eyebrow, icon, title } = Astro.props
---

<div
  class:list={[
    'reveal mb-12',
    align === 'right' && 'text-right',
    align === 'center' && 'text-center',
  ]}
>
  {eyebrow && <p class="mb-4 text-label-14-mono text-zinc-400 text-shadow-subtle">{eyebrow}</p>}
  <div
    class:list={[
      'flex items-center gap-4',
      align === 'right' && 'justify-end',
      align === 'center' && 'justify-center',
    ]}
  >
    {icon && align !== 'right' && (
      <span class="icon-badge" aria-hidden="true">
        <SvgIcon class="size-5" name={icon} />
      </span>
    )}
    <h2 class="section-title text-heading-40 md:text-heading-48">{title}</h2>
    {icon && align === 'right' && (
      <span class="icon-badge" aria-hidden="true">
        <SvgIcon class="size-5" name={icon} />
      </span>
    )}
  </div>
</div>

---
const GRID_CELLS_PER_SIDE = 15
const cells = Array.from({ length: GRID_CELLS_PER_SIDE * GRID_CELLS_PER_SIDE })
---

<div class="hero-3d-wrapper" aria-hidden="true">
  <div
    class="hero-3d-grid"
    style={`--hero-grid-cells: ${GRID_CELLS_PER_SIDE};`}
  >
    {cells.map(() => <div class="hero-grid-cell"></div>)}
  </div>
</div>
